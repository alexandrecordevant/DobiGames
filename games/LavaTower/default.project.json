{
    "name": "LavaTower",
    "tree": {
        "$className": "DataModel",
        "ReplicatedStorage": {
            "$className": "ReplicatedStorage",
            "GameConfig": { "$path": "src/ReplicatedStorage/GameConfig.lua" },
            "Modules": {
                "$path": "src/ReplicatedStorage/Modules"
            },
            "SharedLib": {
                "$className": "Folder",
                "Logger": { "$path": "../shared-lib/src/server/Logger.lua" },
                "Shared": {
                    "$className": "Folder",
                    "AmelioConfig":  { "$path": "../shared-lib/src/shared/AmelioConfig.lua" },
                    "FormatNumber":  { "$path": "../shared-lib/src/shared/FormatNumber.lua" }
                }
            }
        },
        "ServerScriptService": {
            "$className": "ServerScriptService",
            "$path": "src/ServerScriptService",
            "SharedLib": {
                "$className": "Folder",
                "Server": { "$path": "../shared-lib/src/server" },
                "Shared": {
                    "$className": "Folder",
                    "CollectSystem": { "$path": "../shared-lib/src/shared/CollectSystem.lua" },
                    "UpgradeSystem": { "$path": "../shared-lib/src/shared/UpgradeSystem.lua" }
                }
            }
        },
        "StarterPlayer": {
            "$className": "StarterPlayer",
            "StarterPlayerScripts": {
                "$className": "StarterPlayerScripts",
                "Shared": { "$path": "../shared-lib/src/client" },
                "SlotTextStyle": { "$path": "src/StarterPlayer/StarterPlayerScripts/SlotTextStyle.client.lua" },
                "HUDController": { "$path": "src/StarterPlayer/StarterPlayerScripts/HUDController.client.lua" },
                "ShopClient": { "$path": "src/StarterPlayer/StarterPlayerScripts/ShopClient.client.lua" },
                "ShopMonetizationClient": { "$path": "src/StarterPlayer/StarterPlayerScripts/ShopMonetizationClient.client.lua" },
                "TeleportMenuClient": { "$path": "src/StarterPlayer/StarterPlayerScripts/TeleportMenuClient.client.lua" },
                "EventVoteClient": { "$path": "src/StarterPlayer/StarterPlayerScripts/EventVoteClient.client.lua" },
                "LeaderboardScrollClient": { "$path": "src/StarterPlayer/StarterPlayerScripts/LeaderboardScrollClient.client.lua" },
                "MenuController": { "$path": "src/StarterPlayer/StarterPlayerScripts/MenuController.client.lua" },
                "IndexClient": { "$path": "src/StarterPlayer/StarterPlayerScripts/IndexClient.client.lua" },
                "SellConfirmClient": { "$path": "src/StarterPlayer/StarterPlayerScripts/SellConfirmClient.client.lua" },
                "SoundManager": { "$path": "src/StarterPlayer/StarterPlayerScripts/SoundManager.client.lua" }
            }
        }
    }
}
